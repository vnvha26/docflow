DATABASE_URL="postgresql://docflow:docflow_local_only@127.0.0.1:5432/docflow?schema=public"
JWT_SECRET=replace-this-with-at-least-32-random-characters
WEB_ORIGIN=http://127.0.0.1:5173
PORT=3000
NODE_ENV=development
# Local SMTP capture only: messages appear at http://127.0.0.1:8025.
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="DocFlow <no-reply@docflow.local>"
# Object storage (S3-compatible; local MinIO from compose.yaml). Local credentials only.
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_BUCKET=docflow
S3_ACCESS_KEY=docflow
S3_SECRET_KEY=docflow_local_only
# Key-encryption keys for stored files: id:<32 bytes base64>, first = active. npm run setup generates one.
FILE_KEKS=replace-with-npm-run-setup
# Days a deleted item stays in the trash; encrypted storage quota per user.
TRASH_DAYS=30
ENCRYPTED_QUOTA_MB=1024
# Background worker: idle poll interval and housekeeping interval (milliseconds).
WORKER_POLL_MS=2000
WORKER_MAINTENANCE_MS=300000
# AI gateway (OpenAI-compatible: Ollama, vLLM, ...). Production must set AI_BASE_URL.
# Ollama: set OLLAMA_CONTEXT_LENGTH=16384 on the Ollama server, otherwise long documents are cut at 4096 tokens.
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_MODEL=qwen3.5:9b
# AI_API_KEY=
# AI_EMBED_MODEL=
AI_TIMEOUT_MS=180000
AI_MAX_INPUT_CHARS=36000
AI_MAX_OUTPUT_TOKENS=2048
# Extra request fields: Ollama turns Qwen thinking off with reasoning_effort; vLLM uses {"chat_template_kwargs":{"enable_thinking":false}}.
AI_EXTRA_BODY={"reasoning_effort":"none"}
