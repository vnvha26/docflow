{
  "name": "@docflow/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "nest start --watch --path tsconfig.json",
    "start": "node dist/main.js",
    "test": "node ../../tools/api-unit-test.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:validate": "prisma validate",
    "dev:worker": "node --watch-path=dist dist/worker.js",
    "worker": "node dist/worker.js",
    "ai:check": "node dist/ai-check.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1161.0",
    "@nestjs/common": "11.2.8",
    "@nestjs/core": "11.2.8",
    "@nestjs/jwt": "11.0.1",
    "@nestjs/platform-express": "11.2.8",
    "@nestjs/swagger": "11.4.7",
    "@prisma/client": "6.19.0",
    "argon2": "0.44.0",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.2",
    "cookie-parser": "1.4.7",
    "dotenv": "17.2.2",
    "mammoth": "1.13.0",
    "nodemailer": "10.3.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "unpdf": "2.1.0"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.24",
    "@types/cookie-parser": "1.4.9",
    "@types/express": "5.0.3",
    "@types/multer": "2.3.0",
    "@types/node": "22.18.6",
    "@types/nodemailer": "8.0.2",
    "prisma": "6.19.0",
    "typescript": "5.9.3"
  }
}
